# Future Profile — configuration serveur (PHP)
# Copier ce fichier en `.env` et renseigner les valeurs. Ne jamais commiter `.env`.

# Jeton de l'application privée HubSpot (portail ITIC Paris).
# Périmètres requis : crm.objects.contacts.read, crm.objects.contacts.write,
# communication_preferences.read_write (pour le consentement).
HUBSPOT_TOKEN=

# Identifiant du type d'abonnement HubSpot utilisé pour le consentement
# prospection (Paramètres → Marketing → E-mail → Types d'abonnement).
# Si vide, le consentement est journalisé mais non enregistré dans HubSpot.
HUBSPOT_SUBSCRIPTION_ID=

# EF-08 : passer à `true` UNIQUEMENT une fois les propriétés utm_source,
# utm_medium, utm_campaign, utm_term, utm_content créées dans le portail.
HUBSPOT_UTM_PROPERTIES=false

# Clé d'accès au tableau de bord du tunnel (GET /api/stats?key=...).
# Si vide, /api/stats est accessible sans clé (déconseillé en production).
STATS_KEY=

# Passer à `true` derrière un reverse proxy (nginx, Caddy…) pour que la
# limitation de débit utilise l'IP réelle (en-tête X-Forwarded-For).
TRUST_PROXY=false
